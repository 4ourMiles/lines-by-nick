  "narrative": {
    "northStar": "The Built Letter",
    "overview": "The LbN mark is three letters built as solid objects. The site is that object continued at page scale: every surface is a slab with a flat saturated face, a 2px navy outline and a hard diagonal navy extrusion. Clean pop: few unmixed colors, big type, generous air, no texture other than the brand's own pattern tile.",
    "keyCharacteristics": [
      "Hard diagonal navy extrusion on every structural slab; no blurred shadows.",
      "Four unmixed colors carry whole regions.",
      "One heavy rounded geometric family (Rubik) at every size.",
      "Rounded-rectangle geometry matched to the letterforms.",
      "Motion is physical: press, stack, tilt."
    ],
    "rules": [
      {
        "name": "The Side Rule",
        "body": "Depth is a solid navy side, never a blur. Steps 4, 8, 14, 24px.",
        "section": "elevation"
      },
      {
        "name": "The Whole-Region Rule",
        "body": "A brand color owns a region or it does not appear.",
        "section": "colors"
      },
      {
        "name": "The Red Budget Rule",
        "body": "One primary button per viewport plus at most one red slab per page.",
        "section": "colors"
      },
      {
        "name": "The No-Eyebrow Rule",
        "body": "Sections open with their headline; the uppercase label lives inside tags.",
        "section": "typography"
      },
      {
        "name": "The Press Rule",
        "body": "Hover moves 2px onto the side; active moves fully onto it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do draw depth as a navy diagonal side at 4 / 8 / 14 / 24px.",
      "Do let cyan own the hero and navy own the footer.",
      "Do keep 2px navy outlines on every slab and control.",
      "Do author visuals from the slab vocabulary and label synthetic samples."
    ],
    "donts": [
